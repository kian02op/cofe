# ---------------------------------------------------------------
# منوکده — متغیرهای محیطی (نمونه)
# این فایل را به .env کپی و مقادیر را پر کنید.
# scripts/build.mjs این مقادیر را در public/config.js می‌نویسد.
#
# امن برای فرانت‌اند (عمومی):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SITE_URL=https://menu.example.com
#
# فقط سمت سرور — هرگز در فرانت/گیت قرار ندهید:
# SUPABASE_SERVICE_ROLE_KEY=...        (فقط در Secrets توابع Edge)
# ANALYTICS_PEPPER=...                 (فقط در Secrets توابع Edge)
# ALLOWED_ORIGINS=https://menu.example.com (فقط در Secrets توابع Edge)
# ---------------------------------------------------------------
